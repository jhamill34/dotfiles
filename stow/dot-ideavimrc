set easymotion
set sneak
set quickscope
set NERDTree
set which-key

set notimeout

" -- vim-surround remapped to mini.surround's keys (lua/plugins/mini.lua
" runs `require("mini.surround").setup()`, whose defaults are sa/sd/sr —
" see that file's own comment: saiw), sd', sr)'). The vim-surround engine
" underneath is unchanged, just its trigger keys move from ys/ds/cs to
" sa/sd/sr so muscle memory matches nvim. ys/ds/cs still work too.
let g:WhichKeyDesc_surroundAdd = "sa [s]urround [a]dd (e.g. saiw))"
nmap sa <Plug>YSurround
xmap sa <Plug>VSurround
let g:WhichKeyDesc_surroundDelete = "sd [s]urround [d]elete (e.g. sd')"
nmap sd <Plug>DSurround
let g:WhichKeyDesc_surroundReplace = "sr [s]urround [r]eplace (e.g. sr)')"
nmap sr <Plug>CSurround

" -- Move sneak (`set sneak` above) off s/S since mini.surround/vim-surround
" now own the s-prefix above; gs/gS keeps the "goto"-style g-prefix already
" used throughout this file for jump-ish navigation.
nmap gs <Plug>(sneak-s)
xmap gs <Plug>(sneak-s)
nmap gS <Plug>(sneak-S)
unmap s
unmap S
xunmap s

