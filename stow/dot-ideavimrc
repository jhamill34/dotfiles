let g:WhichKeyDesc_lspImplementation = "gri LSP [i]mplementation"
nmap gri <Action>(GotoImplementation)
let g:WhichKeyDesc_lspTypeDef = "grt LSP [t]ype definition"
nmap grt <Action>(GotoTypeDeclaration)
let g:WhichKeyDesc_lspDefinition = "grd LSP [d]efinition"
nmap grd <Action>(GotoDeclaration)
let g:WhichKeyDesc_lspDeclaration = "grD LSP [D]eclaration"
nmap grD <Action>(GotoDeclaration)

