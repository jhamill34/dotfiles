{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "kanso-chrome"
          },
          "size": {
            "px": 48
          },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "kanso-spaces"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "kanso-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 156
          }
        }
      ],
      "size": {
        "px": 256
      },
      "min": 200,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "inset",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "kanso-tabs"
              },
              "size": {
                "px": 48
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "kanso-strip"
                        },
                        "reveal": "always",
                        "height": 34,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 0,
                        "color": "border"
                      },
                      "focus": {
                        "width": 0,
                        "color": "border"
                      },
                      "radius": 8,
                      "gap": 6
                    }
                  },
                  "background": "chrome"
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true,
                  "background": "background",
                  "radius": 8
                }
              ],
              "background": "chrome",
              "padding": 0,
              "gap": 6
            }
          ],
          "resizable": false
        },
        {
          "id": "status-row",
          "type": "row",
          "size": {
            "px": 26
          },
          "resizable": false,
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "kanso-status",
                "props": {
                  "side": "left"
                }
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "strip-map",
              "type": "block",
              "content": {
                "mod": "kanso-strip"
              },
              "size": {
                "px": 180
              }
            },
            {
              "id": "status-right",
              "type": "block",
              "content": {
                "mod": "kanso-status",
                "props": {
                  "side": "right"
                }
              },
              "size": {
                "weight": 1
              }
            }
          ]
        }
      ],
      "padding": 6,
      "gap": 4,
      "resizable": false
    }
  ],
  "background": "chrome",
  "theme": {
    "light": "kanso-day",
    "dark": "kanso"
  },
  "terminal_padding": [
    14,
    10
  ],
  "resizable": true,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/kanso.png",
  "terminal_menu": "kanso-menu"
}
